# Real Azure creation is intentionally disabled by default.
# Enable only after architecture-package approval, model/quota validation,
# RBAC, private connectivity, and cleanup have been verified.
ENABLE_AZURE_DEPLOYMENTS=false
PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Structured API/Azure diagnostics. Long-running Azure CLI calls emit a
# heartbeat at this interval and are terminated after the hard timeout.
LOG_LEVEL=INFO
AZURE_COMMAND_HEARTBEAT_SECONDS=30
AZURE_COMMAND_TIMEOUT_SECONDS=600

# Optional filesystem overrides. Defaults are repository-root/infra
# for templates and repository-root/.runtime for generated runtime data.
# INFRASTRUCTURE_ROOT=/absolute/path/to/infra
# APP_DATA_ROOT=/absolute/path/to/runtime-data

# Existing Azure subscription target. Copy this file to backend/.env and
# restart Uvicorn after changing it. Bicep generates a new
# resource group, Microsoft Foundry account, and child project.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
