# Real Azure creation is intentionally disabled by default.
# Enable only after architecture-package approval, model/quota validation,
# RBAC, private connectivity, and cleanup have been verified.
ENABLE_AZURE_DEPLOYMENTS=false
PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Structured API/Azure diagnostics. Long-running Azure CLI calls emit a
# heartbeat at this interval and are terminated after the hard timeout.
LOG_LEVEL=INFO
AZURE_COMMAND_HEARTBEAT_SECONDS=30
AZURE_COMMAND_TIMEOUT_SECONDS=600

# Checkout templates default to catalog/templates/existing-resource-checkout.
# INFRASTRUCTURE_ROOT=/absolute/path/to/existing-resource-checkout

# Package source, deployment evidence, and starter kits are durable Blob
# artifacts. The backend identity needs Storage Blob Data Contributor.
PACKAGE_ARTIFACT_BACKEND=blob
PACKAGE_ARTIFACT_CONTAINER_URL=https://platformstorage.blob.core.windows.net/launchpad-deployment-artifacts

# Filesystem persistence is an offline development/test fallback only. The AKS
# workload always sets the backend to Blob.
# APP_DATA_ROOT=/absolute/path/to/local-runtime-data

# Backend-owned platform resource profile. The UI does not discover or choose
# arbitrary subscription resources. Packages can create only workload-scoped
# child assets within these preconfigured parents.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
PLATFORM_LOCATION=eastus2
PLATFORM_FOUNDRY_RESOURCE_GROUP=rg-platform-ai
PLATFORM_FOUNDRY_ACCOUNT_NAME=aif-platform
PLATFORM_STORAGE_RESOURCE_GROUP=rg-platform-data
PLATFORM_STORAGE_ACCOUNT_NAME=stplatformdata
PLATFORM_COSMOS_RESOURCE_GROUP=rg-platform-data
PLATFORM_COSMOS_ACCOUNT_NAME=cosmos-platform
PLATFORM_COSMOS_DATABASE_NAME=applications
PLATFORM_SEARCH_RESOURCE_GROUP=rg-platform-ai
PLATFORM_SEARCH_SERVICE_NAME=srch-platform
PLATFORM_SEARCH_INDEX_NAME=approved-content
PLATFORM_MANAGED_IDENTITY_RESOURCE_ID=/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-platform-ai/providers/Microsoft.ManagedIdentity/userAssignedIdentities/id-platform
